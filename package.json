{
  "name": "autojournal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Учебный MVP электронного журнала обслуживания автомобиля",
  "scripts": {
    "dev": "vite --open /tempPage/index.html",
    "build": "vite build && node scripts/fe030-check-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:expenses": "node --test tests/fe018-expense-regression.test.mjs",
    "test:storage": "node --test tests/fe006-local-storage.test.mjs tests/fe027-storage-resilience.test.mjs",
    "test:e2e": "python tests/fe028-e2e-browser.py",
    "test:study": "node --test tests/fe029-user-study.test.mjs",
    "study:report": "node scripts/fe029-analyze-study.mjs",
    "check:build": "node scripts/fe030-check-build.mjs",
    "test:release": "node --test tests/fe030-release.test.mjs",
    "test:live": "python tests/fe031-live-smoke.py --url https://61x-at.github.io/auto_journal/ --report fe031-live-report.json"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
